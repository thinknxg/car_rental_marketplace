{
 "doctype": "DocType",
 "name": "Rental Request",
 "module": "Rental Marketplace",
 "naming_rule": "Expression",
 "autoname": "format:REQ-{YYYY}-{######}",
 "title_field": "customer",
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer (User)",
   "options": "User",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nSubmitted\nMatching\nTendered\nOffers Received\nCustomer Reviewing\nAccepted\nExpired\nCancelled\nClosed",
   "default": "Draft",
   "in_list_view": 1,
   "in_filter": 1
  },
  {
   "fieldname": "col_a",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "currency",
   "fieldtype": "Data",
   "label": "Currency"
  },
  {
   "fieldname": "expires_at",
   "fieldtype": "Datetime",
   "label": "Expires At"
  },
  {
   "fieldname": "sec_trip",
   "fieldtype": "Section Break",
   "label": "Trip"
  },
  {
   "fieldname": "pickup_location",
   "fieldtype": "Link",
   "label": "Pickup Location",
   "options": "Marketplace Location",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "dropoff_location",
   "fieldtype": "Link",
   "label": "Dropoff Location",
   "options": "Marketplace Location"
  },
  {
   "fieldname": "same_return_location",
   "fieldtype": "Check",
   "label": "Same Return Location",
   "default": 1
  },
  {
   "fieldname": "col_b",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "pickup_datetime",
   "fieldtype": "Datetime",
   "label": "Pickup",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "dropoff_datetime",
   "fieldtype": "Datetime",
   "label": "Dropoff",
   "reqd": 1
  },
  {
   "fieldname": "sec_vehicle",
   "fieldtype": "Section Break",
   "label": "Vehicle Requirements"
  },
  {
   "fieldname": "vehicle_class",
   "fieldtype": "Link",
   "label": "Vehicle Class",
   "options": "Vehicle Class",
   "reqd": 1,
   "in_filter": 1
  },
  {
   "fieldname": "preferred_make",
   "fieldtype": "Data",
   "label": "Preferred Make"
  },
  {
   "fieldname": "preferred_model",
   "fieldtype": "Data",
   "label": "Preferred Model"
  },
  {
   "fieldname": "col_c",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "transmission",
   "fieldtype": "Select",
   "label": "Transmission",
   "options": "\nAutomatic\nManual"
  },
  {
   "fieldname": "fuel_type",
   "fieldtype": "Select",
   "label": "Fuel",
   "options": "\nPetrol\nDiesel\nHybrid\nElectric"
  },
  {
   "fieldname": "seats_required",
   "fieldtype": "Int",
   "label": "Seats Required",
   "default": 4
  },
  {
   "fieldname": "sec_driver",
   "fieldtype": "Section Break",
   "label": "Driver"
  },
  {
   "fieldname": "driver_age",
   "fieldtype": "Int",
   "label": "Driver Age"
  },
  {
   "fieldname": "country_of_residence",
   "fieldtype": "Data",
   "label": "Country of Residence"
  },
  {
   "fieldname": "sec_extras",
   "fieldtype": "Section Break",
   "label": "Extras"
  },
  {
   "fieldname": "extras",
   "fieldtype": "Table",
   "label": "Requested Extras",
   "options": "Rental Request Extra"
  },
  {
   "fieldname": "special_requirements",
   "fieldtype": "Small Text",
   "label": "Special Requirements"
  },
  {
   "fieldname": "sec_partner",
   "fieldtype": "Section Break",
   "label": "Attribution",
   "collapsible": 1
  },
  {
   "fieldname": "referral_code",
   "fieldtype": "Data",
   "label": "Referral Code",
   "read_only": 1
  },
  {
   "fieldname": "partner",
   "fieldtype": "Link",
   "label": "Attributed Partner",
   "options": "Marketplace Partner",
   "read_only": 1,
   "in_filter": 1
  }
 ],
 "permissions": [
  {
   "role": "Marketplace Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1
  },
  {
   "role": "Marketplace Operations",
   "read": 1,
   "write": 1,
   "report": 1
  },
  {
   "role": "Marketplace Support",
   "read": 1
  },
  {
   "role": "Marketplace Customer",
   "read": 1,
   "write": 1,
   "create": 1,
   "if_owner": 1
  }
 ]
}