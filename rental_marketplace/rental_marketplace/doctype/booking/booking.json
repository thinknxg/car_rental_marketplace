 ],
 "permissions": [
  {
   "role": "Marketplace Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1
  },
  {
   "role": "Marketplace Operations",
   "read": 1,
   "write": 1,
   "report": 1
  },
  {
   "role": "Marketplace Finance",
   "read": 1,
