{
 "doctype": "DocType",
 "name": "Booking",
 "module": "Rental Marketplace",
 "naming_rule": "Expression",
 "autoname": "format:BKG-{YYYY}-{######}",
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "booking_reference",
   "fieldtype": "Data",
   "label": "Reference",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer (User)",
   "options": "User",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "supplier",
   "fieldtype": "Link",
   "label": "Supplier",
   "options": "Marketplace Supplier",
   "reqd": 1,
   "in_list_view": 1,
   "in_filter": 1
  },
  {
   "fieldname": "col_a",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "booking_status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Pending Approval\nPending Payment\nConfirmed\nSupplier Confirmed\nReady for Pickup\nPicked Up\nActive Rental\nReturned\nCompleted\nCancelled\nNo Show\nDisputed",
   "default": "Pending Approval",
   "in_list_view": 1,
   "in_filter": 1
  },
  {
   "fieldname": "payment_status",
   "fieldtype": "Select",
   "label": "Payment",
   "options": "Unpaid\nPartially Paid\nPaid\nRefunded\nPartially Refunded",
   "default": "Unpaid",
   "in_list_view": 1,
   "in_filter": 1
  },
  {
   "fieldname": "cancellation_status",
   "fieldtype": "Select",
   "label": "Cancellation",
   "options": "\nRequested\nProcessed",
   "in_filter": 1
  },
  {
   "fieldname": "sec_links",
   "fieldtype": "Section Break",
   "label": "Origin"
  },
  {
   "fieldname": "accepted_offer",
   "fieldtype": "Link",
   "label": "Accepted Offer",
   "options": "Offer",
   "reqd": 0
  },
  {
   "fieldname": "rental_request",
   "fieldtype": "Link",
   "label": "Rental Request",
   "options": "Rental Request"
  },
  {
   "fieldname": "col_b",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "vehicle",
   "fieldtype": "Link",
   "label": "Vehicle",
   "options": "Marketplace Vehicle",
   "reqd": 1
  },
  {
   "fieldname": "availability_block",
   "fieldtype": "Link",
   "label": "Availability Block",
   "options": "Vehicle Availability Block",
   "read_only": 1
  },
  {
   "fieldname": "sec_trip",
   "fieldtype": "Section Break",
   "label": "Trip"
