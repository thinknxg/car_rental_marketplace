  {
   "fieldname": "extras_amount",
   "fieldtype": "Currency",
   "precision": 2,
   "label": "Extras"
  },
  {
   "fieldname": "col_d",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "fees_amount",
   "fieldtype": "Currency",
   "precision": 2,
   "label": "Fees"
