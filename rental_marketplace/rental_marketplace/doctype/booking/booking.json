   "options": "Marketplace Partner",
   "read_only": 1,
   "in_filter": 1
  },
  {
   "fieldname": "partner_commission",
   "fieldtype": "Currency",
   "precision": 2,
   "label": "Partner Commission",
   "read_only": 1
  },
  {
