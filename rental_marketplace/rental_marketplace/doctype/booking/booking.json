   "fieldtype": "Section Break",
   "label": "Payment State"
  },
  {
   "fieldname": "amount_paid",
   "fieldtype": "Currency",
   "precision": 2,
   "label": "Paid",
   "read_only": 1
  },
  {
   "fieldname": "col_f",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "amount_due",
   "fieldtype": "Currency",
   "precision": 2,
   "label": "Due",
   "read_only": 1
  },
  {
   "fieldname": "sec_snapshots",
   "fieldtype": "Section Break",
   "label": "Snapshots (immutable)",
   "collapsible": 1
  },
  {
   "fieldname": "customer_snapshot",
   "fieldtype": "JSON",
   "label": "Customer Snapshot",
   "read_only": 1
  },
  {
   "fieldname": "supplier_snapshot",
   "fieldtype": "JSON",
   "label": "Supplier Snapshot",
   "read_only": 1
  },
  {
   "fieldname": "vehicle_snapshot",
   "fieldtype": "JSON",
   "label": "Vehicle Snapshot",
   "read_only": 1
  },
  {
   "fieldname": "pricing_snapshot",
   "fieldtype": "JSON",
   "label": "Pricing Snapshot",
   "read_only": 1
  },
  {
   "fieldname": "extras_snapshot",
   "fieldtype": "JSON",
   "label": "Extras Snapshot",
   "read_only": 1
  },
  {
   "fieldname": "extras_snapshot",
   "fieldtype": "JSON",
   "label": "Extras Snapshot",
   "read_only": 1
  },
  {
   "fieldname": "policy_snapshot",
   "fieldtype": "JSON",
   "label": "Policy Snapshot",
   "read_only": 1
  },
  {
   "fieldname": "sec_ts",
   "fieldtype": "Section Break",
   "label": "Timestamps"
  },
  {
   "fieldname": "confirmed_at",
   "fieldtype": "Datetime",
   "label": "Confirmed",
   "read_only": 1
  },
  {
   "fieldname": "col_g",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "cancelled_at",
   "fieldtype": "Datetime",
   "label": "Cancelled",
   "read_only": 1
