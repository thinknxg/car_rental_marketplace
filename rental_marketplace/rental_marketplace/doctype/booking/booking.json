  },
  {
   "role": "Marketplace Support",
   "read": 1
  },
  {
   "role": "Supplier Admin",
   "read": 1
  },
  {
   "role": "Supplier Manager",
   "read": 1
  },
  {
   "role": "Supplier Agent",
   "read": 1
